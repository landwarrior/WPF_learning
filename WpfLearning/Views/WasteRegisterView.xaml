<UserControl x:Class="WpfLearning.Views.WasteRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WpfLearning.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WasteRegisterViewModel, IsDesignTimeCreatable=False}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="760"
                HorizontalAlignment="Left"
                Padding="24"
                Background="White"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="1" Opacity="0.08" Color="#111827"/>
            </Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="収集日 *" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding CollectedOn, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding CollectedOnError}" Style="{StaticResource FieldError}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="マニフェスト番号（任意）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ManifestNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding ManifestNumberError}" Style="{StaticResource FieldError}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="排出事業者 *" Style="{StaticResource FieldLabel}"/>
                    <!-- UpdateSourceTrigger=PropertyChanged で、入力のたびに ViewModel へ反映する。 -->
                    <TextBox Text="{Binding GeneratorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding GeneratorNameError}" Style="{StaticResource FieldError}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="廃棄物の種類 *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding WasteNames}"
                              SelectedItem="{Binding WasteName, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding WasteNameError}" Style="{StaticResource FieldError}"/>
                </StackPanel>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="数量 *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding QuantityError}" Style="{StaticResource FieldError}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="単位 *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Units}"
                                  SelectedItem="{Binding Unit, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding UnitError}" Style="{StaticResource FieldError}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="処分方法 *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding DisposalMethods}"
                              SelectedItem="{Binding DisposalMethod, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding DisposalMethodError}" Style="{StaticResource FieldError}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="備考" Style="{StaticResource FieldLabel}"/>
                    <TextBox MinHeight="96"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="画像" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="カメラを起動して撮影すると、この記録に画像を添付できます。画像は記録と一緒にデータベースへ保存されます。"/>
                    <Border Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Background="#111827"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CameraPreview}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Command="{Binding EnlargePreviewCommand}"
                                Style="{StaticResource ImageButton}"
                                ToolTip="拡大表示">
                            <Viewbox MaxWidth="640" MaxHeight="240" Stretch="Uniform">
                                <Image Source="{Binding CameraPreview}" Stretch="None"/>
                            </Viewbox>
                        </Button>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding CameraButtonText}"
                                Command="{Binding ToggleCameraCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                        <Button Margin="8,0,0,0"
                                Content="撮影して添付"
                                Command="{Binding CaptureCommand}"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CameraMessage}" Style="{StaticResource FieldError}"/>
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Images}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,8,0">
                                    <Button Command="{Binding OpenCommand}"
                                            Style="{StaticResource ImageButton}"
                                            ToolTip="拡大表示">
                                        <Border CornerRadius="6"
                                                BorderBrush="{StaticResource CardBorderBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Viewbox MaxWidth="160" MaxHeight="120" Stretch="Uniform">
                                                <Image Source="{Binding Preview}" Stretch="None"/>
                                            </Viewbox>
                                        </Border>
                                    </Button>
                                    <Button Margin="0,6,0,0"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            Content="外す"
                                            Command="{Binding RemoveCommand}"
                                            Style="{StaticResource SecondaryButton}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding SubmitButtonText}"
                            IsDefault="True"
                            Command="{Binding RegisterCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                    <Button Margin="8,0,0,0"
                            Content="{Binding ClearButtonText}"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
